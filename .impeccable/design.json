  "components": [
    {
      "name": "Hauptknopf A",
      "kind": "button",
      "refersTo": "ajrakh-knopf-haupt",
      "description": "Kurkuma-Druckknopf auf den Bahnen von Thema A.",
      "html": "<a class=\"ds-knopf-a\" href=\"#\">Tisch reservieren</a>",
      "css": ".ds-knopf-a{display:inline-flex;align-items:center;justify-content:center;gap:.55em;min-height:48px;padding:.7em 1.35em;font-family:Mukta,'Segoe UI',system-ui,sans-serif;font-weight:700;font-size:1rem;letter-spacing:.01em;line-height:1.1;text-decoration:none;border-radius:3px;background:#edb23a;color:#1a100c;box-shadow:0 1px 0 rgba(0,0,0,.25),0 8px 22px -10px rgba(0,0,0,.6);transition:transform .16s cubic-bezier(.23,1,.32,1),background-color .2s ease,box-shadow .2s ease}.ds-knopf-a:hover{background:#f6c65e;box-shadow:0 1px 0 rgba(0,0,0,.25),0 14px 28px -12px rgba(0,0,0,.7)}.ds-knopf-a:active{transform:scale(.97)}.ds-knopf-a:focus-visible{outline:2px solid #edb23a;outline-offset:3px}"
    },
    {
      "name": "Linienknopf A",
      "kind": "button",
      "refersTo": "ajrakh-knopf-linie",
      "description": "Zweite Handlung auf Krapprot, z. B. „Online bestellen“.",
      "html": "<div style=\"background:#6e1518;padding:20px\"><a class=\"ds-linie-a\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\" d=\"M4.5 8h15l-1.2 12.5H5.7L4.5 8z\"/><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" d=\"M8.5 10V6.5a3.5 3.5 0 0 1 7 0V10\"/></svg>Online bestellen</a></div>",
      "css": ".ds-linie-a{display:inline-flex;align-items:center;gap:.55em;min-height:48px;padding:.7em 1.35em;font-family:Mukta,'Segoe UI',system-ui,sans-serif;font-weight:700;text-decoration:none;border-radius:3px;color:#f3e7d3;box-shadow:inset 0 0 0 1.5px currentColor;transition:background-color .2s ease,transform .16s cubic-bezier(.23,1,.32,1)}.ds-linie-a:hover{background:rgba(243,231,211,.1)}.ds-linie-a:active{transform:scale(.97)}.ds-linie-a:focus-visible{outline:2px solid #edb23a;outline-offset:3px}"
    },
    {
      "name": "Hauptknopf B",
      "kind": "button",
      "refersTo": "thali-knopf-haupt",
      "description": "Kurkuma-Pille mit Glanzkante in Thema B.",
      "html": "<a class=\"ds-knopf-b\" href=\"#\">Tisch reservieren</a>",
      "css": ".ds-knopf-b{display:inline-flex;align-items:center;justify-content:center;gap:.55em;min-height:48px;padding:.7em 1.35em;font-family:'Anek Latin','Segoe UI',system-ui,sans-serif;font-weight:600;font-size:1rem;line-height:1.1;text-decoration:none;border-radius:999px;background:#e7a92f;color:#1a120c;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 10px 24px -12px rgba(0,0,0,.7);transition:transform .16s cubic-bezier(.23,1,.32,1),background-color .2s ease}.ds-knopf-b:hover{background:#f3bf55}.ds-knopf-b:active{transform:scale(.97)}.ds-knopf-b:focus-visible{outline:2px solid #e7a92f;outline-offset:3px}"
    },
    {
      "name": "Reservier-Chips (Tuch A)",
      "kind": "chip",
      "refersTo": "ajrakh-chip",
      "description": "Personen- und Zeitwahl auf dem hellen Reservier-Tuch; gewählt Krapprot.",
      "html": "<div class=\"ds-tuch\"><button class=\"ds-chip-a\">1</button><button class=\"ds-chip-a\" aria-pressed=\"true\">2</button><button class=\"ds-chip-a\">3</button><button class=\"ds-chip-a\" disabled>14:00</button></div>",
      "css": ".ds-tuch{display:flex;gap:8px;flex-wrap:wrap;padding:24px;background:#f3e7d3;color:#1d1310}.ds-chip-a{min-width:52px;min-height:48px;padding:.4em .9em;font:500 1rem Mukta,system-ui,sans-serif;font-variant-numeric:tabular-nums;color:inherit;background:none;border:1px solid rgba(29,19,16,.22);border-radius:3px;cursor:pointer;transition:background-color .18s ease,color .18s ease,border-color .18s ease,transform .16s cubic-bezier(.23,1,.32,1)}.ds-chip-a:hover:not([disabled]){border-color:currentColor}.ds-chip-a:active{transform:scale(.96)}.ds-chip-a[aria-pressed=true]{background:#6e1518;color:#f3e7d3;border-color:#6e1518}.ds-chip-a[disabled]{opacity:.35;text-decoration:line-through;cursor:not-allowed}.ds-chip-a:focus-visible{outline:2px solid #8c2220;outline-offset:3px}"
    },
    {
      "name": "Finder-Option",
      "kind": "chip",
      "refersTo": "finder-option",
      "description": "Pillen-Auswahl im Geschmacks-Finder, beide Themen; gewählt Kurkuma.",
      "html": "<div class=\"ds-finder\"><button class=\"ds-opt\">Mild</button><button class=\"ds-opt\" aria-pressed=\"true\">Würzig</button><button class=\"ds-opt\">Richtig scharf</button></div>",
      "css": ".ds-finder{display:flex;gap:8px;flex-wrap:wrap;padding:20px;background:#120e0b;color:#efe6d8}.ds-opt{min-height:48px;padding:.5em 1.05em;font:500 1rem 'Anek Latin',system-ui,sans-serif;color:inherit;background:none;border:1px solid rgba(239,230,216,.18);border-radius:999px;cursor:pointer;transition:background-color .18s ease,color .18s ease,border-color .18s ease,transform .16s cubic-bezier(.23,1,.32,1)}.ds-opt:hover{border-color:currentColor}.ds-opt:active{transform:scale(.96)}.ds-opt[aria-pressed=true]{background:#e7a92f;color:#1a120c;border-color:#e7a92f}.ds-opt:focus-visible{outline:2px solid #e7a92f;outline-offset:3px}"
    },
    {
      "name": "Speisekarten-Suche",
      "kind": "input",
      "refersTo": "eingabefeld",
      "description": "Suchzeile der klebenden Kartenwerkzeuge; reagiert als Ganzes auf Fokus.",
      "html": "<label class=\"ds-suche\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" d=\"M15.5 15.5 20 20\"/></svg><input placeholder=\"Gericht oder Zutat suchen\"></label>",
      "css": ".ds-suche{display:flex;align-items:center;gap:10px;min-height:48px;padding:0 14px;background:#10173a;color:#f3e7d3;border:1px solid rgba(243,231,211,.3);border-radius:3px;font-family:Mukta,system-ui,sans-serif}.ds-suche input{flex:1;min-width:0;min-height:46px;border:0;background:transparent;color:inherit;font:inherit;outline:none}.ds-suche input::placeholder{color:rgba(243,231,211,.76)}.ds-suche:focus-within{border-color:#edb23a}"
    },
    {
      "name": "Kopfnavigation A",
      "kind": "nav",
      "refersTo": "",
      "description": "Gedämpfte Links, Kurkuma-Unterstrich wächst beim Hover von links.",
      "html": "<nav class=\"ds-nav-a\"><a href=\"#\">Lieblinge</a><a href=\"#\">Speisekarte</a><a href=\"#\">Zeiten &amp; Anfahrt</a></nav>",
      "css": ".ds-nav-a{display:flex;gap:4px;padding:14px;background:rgba(24,16,14,.9)}.ds-nav-a a{position:relative;padding:.5em .75em;font:500 .98rem Mukta,system-ui,sans-serif;text-decoration:none;color:rgba(243,231,211,.8);transition:color .2s ease}.ds-nav-a a::after{content:\"\";position:absolute;left:.75em;right:.75em;bottom:.25em;height:1.5px;background:#edb23a;transform:scaleX(0);transform-origin:left;transition:transform .35s cubic-bezier(.23,1,.32,1)}.ds-nav-a a:hover{color:#f3e7d3}.ds-nav-a a:hover::after{transform:scaleX(1)}.ds-nav-a a:focus-visible{outline:2px solid #edb23a;outline-offset:3px}"
    },
    {
      "name": "Kopfnavigation B",
      "kind": "nav",
      "refersTo": "",
      "description": "Gedämpfte Links, Hover als Milch-Pille.",
      "html": "<nav class=\"ds-nav-b\"><a href=\"#\">Lieblinge</a><a href=\"#\">Gewürze</a><a href=\"#\">Speisekarte</a></nav>",
      "css": ".ds-nav-b{display:flex;gap:2px;padding:14px;background:rgba(18,14,11,.88)}.ds-nav-b a{padding:.45em .8em;font:500 .98rem 'Anek Latin',system-ui,sans-serif;text-decoration:none;border-radius:999px;color:rgba(239,230,216,.78);transition:color .2s ease,background-color .2s ease}.ds-nav-b a:hover{color:#efe6d8;background:rgba(239,230,216,.08)}.ds-nav-b a:focus-visible{outline:2px solid #e7a92f;outline-offset:3px}"
    },
    {
      "name": "Heute-Status",
      "kind": "custom",
      "refersTo": "",
      "description": "Offen/geschlossen mit pulsierendem Punkt, auf jeder Bühne und bei der Reservierung.",
      "html": "<p class=\"ds-status\"><span class=\"ds-punkt\"></span><span class=\"ds-text\">Jetzt geöffnet</span><span class=\"ds-zusatz\">bis 22:00</span></p>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:.6em;padding:16px;background:#6e1518;color:#9fe0a8;font:500 1.0625rem Mukta,system-ui,sans-serif}.ds-punkt{position:relative;width:.62em;height:.62em;border-radius:50%;background:currentColor}.ds-punkt::after{content:\"\";position:absolute;inset:0;border-radius:50%;background:currentColor;animation:ds-puls 2.4s cubic-bezier(.23,1,.32,1) infinite}@keyframes ds-puls{0%{transform:scale(1);opacity:.55}100%{transform:scale(2.8);opacity:0}}.ds-text{color:#f3e7d3;font-weight:700}.ds-zusatz{color:rgba(243,231,211,.8);font-weight:400}.ds-zusatz::before{content:\"·\";margin-right:.6em;opacity:.6}@media (prefers-reduced-motion:reduce){.ds-punkt::after{animation:none}}"
    },
    {
      "name": "Reservier-Fortschritt",
      "kind": "custom",
      "refersTo": "",
      "description": "Segmentbalken der vier Reservierschritte, füllt sich von links in der Handlungsfarbe.",
      "html": "<ol class=\"ds-schritte\"><li class=\"an\"></li><li class=\"an\"></li><li></li><li></li></ol>",
      "css": ".ds-schritte{display:flex;gap:6px;list-style:none;margin:0;padding:20px;background:#f3e7d3}.ds-schritte li{flex:1;height:3px;border-radius:3px;background:rgba(29,19,16,.22);position:relative;overflow:hidden}.ds-schritte li::after{content:\"\";position:absolute;inset:0;background:#6e1518;transform:scaleX(0);transform-origin:left;transition:transform .5s cubic-bezier(.23,1,.32,1)}.ds-schritte li.an::after{transform:scaleX(1)}"
    }
  ],
  "narrative": {
    "northStar": "Was auf dem Tisch liegt",
    "overview": "Beide Themen holen ihre Gestaltung aus einem echten Gegenstand der indischen Esskultur statt aus einem Restaurant-Stil. Thema A ist ein handbedrucktes Ajrakh-Tuch: Abschnitte sind vollflächig bedruckte Bahnen in Krapprot, Indigo und Kohle, mit einem Rosetten-Jaal als Rapport, Punktbordüren zwischen den Bahnen und Fotos in Bogenfenstern, die aus dem Logo geschnitten sind. Bewegung ist das Aufdrücken eines Stempels. Thema B ist ein gedeckter Tisch: Tawa-Schwarz, gehämmertes Kupfer, konzentrisch gebürsteter Edelstahl. Die Lieblingsgerichte liegen in Katoris auf einer drehbaren Thali-Platte, die Gewürze in einer Masala-Dabba, deren Deckel beim Scrollen abgleitet. Bewegung ist Licht, das angeht, und Metall, das sich dreht.\n\nGemeinsam ist beiden die Ordnung: Das Essen und der Raum sind die Hauptdarsteller, die Gestaltung rahmt. Kurkuma ist in beiden Welten die einzige Handlungsfarbe. Die Dichte ist großzügig (Abschnitte 80 bis 140 px Innenabstand), die Seite liest sich als eine Folge ganzer Bahnen, nicht als Kartenraster. „Heute offen?“ und „Tisch reservieren“ sind auf jedem Bildschirm einen Daumen weit entfernt: oben im Kopf, auf Mobilgeräten in der Daumenleiste.\n\nAbgelehnt sind in beiden Verträgen das schwarz-goldene „Luxus-Inder“-Klischee und das Foodfoto- bzw. Kartenraster.",
    "keyCharacteristics": [
      "Ein Gegenstand pro Thema (Tuch oder Tisch), aus dem Farbe, Form, Textur und Bewegung abgeleitet sind.",
      "Vollflächige Bahnen statt Karten; Abgrenzung durch Feldwechsel, Bordüren und Linien.",
      "Kurkuma nur für Handlungen; alle anderen Farben sind Material.",
      "Dunkle, warme Grundflächen mit hellem Lesetext; helle Flächen nur für das Formular (Tuch bzw. Stahltablett) und die Merkzettel-Schublade in A.",
      "Display-Schrift als Stempel (A) bzw. Gravur (B), humanistische Grotesk als Lesetext.",
      "Material entsteht aus Code: Inline-SVG-Rapporte in A, mit `tools/materialien.py` gerenderte Raster in B. Keine Fremdbilder für Material."
    ],
    "rules": [
      {
        "name": "Die Kurkuma-Regel",
        "body": "Kurkuma bedeutet „hier handeln“. Jede Fläche in Kurkuma ist klickbar oder zeigt einen gewählten Zustand; Dekor in Kurkuma ist auf die kleinen Trennpunkte und Zitatlinien in A beschränkt. Auf hellen Flächen (Tuch, Stahl) übernimmt Krapprot bzw. Lasurbraun diese Rolle.",
        "section": "colors"
      },
      {
        "name": "Die Material-statt-Farbe-Regel (B)",
        "body": "Stahl und Kupfer sind gerenderte Raster aus `tools/materialien.py`, nie CSS-Verläufe in Grau oder Orange. Neue Metallflächen werden im Skript gerendert und in `img/QUELLEN.md` belegt.",
        "section": "colors"
      },
      {
        "name": "Die Nie-flach-Regel (A)",
        "body": "Jede Bahn trägt ihren Rapport: Krapp und Indigo den Jaal, Bühne und Lieblinge den dichten Jaal, Kohle den Kohle-Jaal, darüber ein ruhendes Korn (`multiply`, 55 %). Eine einfarbige Bahn ohne Druck gibt es nicht.",
        "section": "colors"
      },
      {
        "name": "Die Ziffern-Regel",
        "body": "Preise, Nummern, Uhrzeiten, Zähler und die Öffnungszeiten-Tabelle stehen in tabellarischen Ziffern.",
        "section": "typography"
      },
      {
        "name": "Die Eine-Überschrift-Regel",
        "body": "Eine Bahn hat genau eine Überschrift in Display-Schrift; Kontext steht im Absatz darunter, nicht in einer Kleinzeile darüber.",
        "section": "typography"
      },
      {
        "name": "Die Gegenstand-Regel",
        "body": "Ein Schatten bedeutet „das ist ein Ding“. In B tragen ihn Metallobjekte und das Tablett, in A nur Tuch, Hauptknopf und die schwebenden Ebenen. Flächen, Karten oder Textblöcke bekommen keinen.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** jede neue Fläche über die Rollenvariablen des Themas (`--bg`, `--fg`, `--line`, `--accent`, `--focus`) aufbauen, damit die gemeinsamen Bausteine unverändert funktionieren; helle Inseln setzen ihre Rollen lokal um wie Tuch und Tablett.",
      "**Do** Kurkuma nur für Handlungen und gewählte Zustände verwenden; auf hellen Flächen Krapprot (A) bzw. Lasurbraun (B).",
      "**Do** in A jede Bahn mit ihrem Jaal und dem Korn bedrucken und Bahnen mit der Punktbordüre (30 px hoch, 44 px Rapport) trennen.",
      "**Do** in A Fotos im Bogenfenster aus dem Logo zeigen; in B Gerichte in Stahl-Katoris oder als hohe Bänder mit 22 px Radius.",
      "**Do** neue Metall- oder Gewürzflächen in B mit `tools/materialien.py` rendern und in `img/QUELLEN.md` eintragen; das Logo nur über `tools/logo.py` ändern (erzeugt `js/logo.js`).",
      "**Do** Treffflächen von mindestens 44 px (Knöpfe und Chips 48 px) einhalten und `:hover` nur unter `@media (hover: hover)` setzen.",
      "**Do** jede Bewegung mit `prefers-reduced-motion` zu einem ruhigen Endzustand machen; scrollgesteuerte Bühnen werden statisch.",
      "**Do** `--ease-out` (`cubic-bezier(0.23, 1, 0.32, 1)`) für Ein- und Auftritte verwenden; in A den Stempel-Überschwinger (`cubic-bezier(.3, 1.4, .5, 1)`), in B das Lichtangehen der Bühne."
    ],
    "donts": [
      "**Don't** das schwarz-goldene „Luxus-Inder“-Klischee bauen (Gold auf Schwarz als Schmuck, Ornamentrahmen ohne Herkunft).",
      "**Don't** Inhalte in Kartenraster oder ein Foodfoto-Raster legen; Inhalt sitzt auf der Bahn.",
      "**Don't** Stahl oder Kupfer in B als CSS-Grauverlauf oder flaches Orange nachahmen.",
      "**Don't** in A eine Bahn flach einfärben oder Schatten auf Textblöcke legen; Tiefe kommt aus Druck und Feldwechsel.",
      "**Don't** Kurkuma als Dekorfläche oder für Filterzustände verwenden; Filter sind invertiert.",
      "**Don't** eine Kleinzeile oder Dachzeile über Abschnittsüberschriften setzen.",
      "**Don't** die beiden Themen mischen: keine Bogenfenster in B, keine Stahlobjekte oder Pillenknöpfe in A.",
      "**Don't** den A/B-Umschalter (Navigationslink und Fußzeilen-Hinweis) als Bestandteil übernehmen; er ist nur für die Abnahme."
    ]
  }
