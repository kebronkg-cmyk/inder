  "components": [
    {
      "name": "Pille voll",
      "kind": "button",
      "refersTo": "pille-voll",
      "description": "Primäre Handlung auf Weiß: Bestellen, Route, Ganze Speisekarte.",
      "html": "<button class=\"ds-pille ds-pille--voll\"><svg class=\"ds-ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>Bestellen</button>",
      "css": ".ds-pille{display:inline-flex;align-items:center;justify-content:center;gap:.6em;min-height:52px;padding:0 1.55em;border-radius:999px;font-family:var(--text,'Hanken Grotesk',sans-serif);font-weight:600;font-size:1rem;letter-spacing:.005em;white-space:nowrap;border:0;cursor:pointer;transition:transform .18s cubic-bezier(.23,1,.32,1),background-color .25s ease,color .25s ease}.ds-pille:active{transform:scale(.97)}.ds-pille:focus-visible{outline:2px solid #c4145d;outline-offset:3px}.ds-ico{width:1.1em;height:1.1em}.ds-pille--voll{background:#17110e;color:#fff}.ds-pille--voll:hover{background:#33261f}"
    },
    {
      "name": "Pille Rand",
      "kind": "button",
      "refersTo": "pille-rand",
      "description": "Zweite Handlung neben der vollen Pille (Tisch reservieren, Anrufen).",
      "html": "<button class=\"ds-pille-rand\">Tisch reservieren</button>",
      "css": ".ds-pille-rand{display:inline-flex;align-items:center;min-height:52px;padding:0 1.55em;border-radius:999px;font-family:'Hanken Grotesk',sans-serif;font-weight:600;font-size:1rem;background:transparent;color:#17110e;border:0;box-shadow:inset 0 0 0 1.5px currentColor;cursor:pointer;transition:transform .18s cubic-bezier(.23,1,.32,1),background-color .25s ease}.ds-pille-rand:hover{background:rgba(23,17,14,.06)}.ds-pille-rand:active{transform:scale(.97)}.ds-pille-rand:focus-visible{outline:2px solid #c4145d;outline-offset:3px}"
    },
    {
      "name": "Pille hell auf Gerichtsfläche",
      "kind": "button",
      "refersTo": "pille-hell",
      "description": "Auf den Bestellzettel, auf pfauenblauer, kardamomgrüner oder pinker Fläche.",
      "html": "<div class=\"ds-flaeche\"><button class=\"ds-pille-hell\" aria-pressed=\"false\">Auf den Bestellzettel</button></div>",
      "css": ".ds-flaeche{background:#0d5a60;color:#fff;padding:32px}.ds-pille-hell{min-height:52px;padding:0 1.55em;border-radius:999px;border:0;font-family:'Hanken Grotesk',sans-serif;font-weight:600;font-size:1rem;background:#fff;color:#17110e;cursor:pointer;transition:background-color .25s ease,transform .18s cubic-bezier(.23,1,.32,1)}.ds-pille-hell:hover{background:rgba(255,255,255,.88)}.ds-pille-hell:active{transform:scale(.97)}.ds-pille-hell[aria-pressed=true]{background:rgba(255,255,255,.18);color:inherit;box-shadow:inset 0 0 0 1.5px currentColor}.ds-pille-hell:focus-visible{outline:2px solid #fff;outline-offset:3px}"
    },
    {
      "name": "Feld",
      "kind": "input",
      "refersTo": "feld",
      "description": "Formularfeld im Bestellzettel; Label darüber, Fokus mit Tinten-Halo.",
      "html": "<label class=\"ds-feld\"><span>Name</span><input placeholder=\"Ihr Name\"></label>",
      "css": ".ds-feld{display:grid;gap:5px;font-family:'Hanken Grotesk',sans-serif}.ds-feld span{font-size:.85rem;font-weight:600;color:rgba(23,17,14,.68)}.ds-feld input{min-height:50px;padding:.7em 1em;border-radius:14px;border:1px solid rgba(23,17,14,.12);background:#fff;font:inherit;color:#17110e;transition:border-color .2s ease,box-shadow .2s ease}.ds-feld input::placeholder{color:rgba(23,17,14,.5)}.ds-feld input:focus{outline:none;border-color:#17110e;box-shadow:0 0 0 4px rgba(23,17,14,.08)}"
    },
    {
      "name": "Segment",
      "kind": "custom",
      "refersTo": "segment",
      "description": "Abholen / Liefern: Porzellan-Mulde mit weißem Gleiter.",
      "html": "<div class=\"ds-segment\" data-wert=\"abholen\"><span class=\"ds-gleiter\"></span><button aria-pressed=\"true\">Abholen</button><button aria-pressed=\"false\">Liefern</button></div>",
      "css": ".ds-segment{display:grid;grid-template-columns:1fr 1fr;background:#f3f3f5;border-radius:999px;padding:4px;position:relative;font-family:'Hanken Grotesk',sans-serif;width:320px}.ds-segment button{position:relative;z-index:1;min-height:42px;border:0;background:none;border-radius:999px;font:inherit;font-weight:600;cursor:pointer}.ds-segment button:focus-visible{outline:2px solid #c4145d;outline-offset:3px}.ds-gleiter{position:absolute;top:4px;bottom:4px;left:4px;width:calc(50% - 4px);border-radius:999px;background:#fff;box-shadow:0 2px 8px -2px rgba(23,17,14,.2);transition:transform .45s cubic-bezier(.23,1,.32,1)}.ds-segment:hover .ds-gleiter{transform:translateX(100%)}"
    },
    {
      "name": "Filter-Chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Filter der Speisekarte (Vegetarisch, Vegan).",
      "html": "<button class=\"ds-chip\" aria-pressed=\"false\">Vegetarisch</button> <button class=\"ds-chip\" aria-pressed=\"true\">Vegan</button>",
      "css": ".ds-chip{min-height:44px;padding:0 1.1em;border-radius:999px;border:0;background:none;color:#17110e;box-shadow:inset 0 0 0 1.5px rgba(23,17,14,.12);font-family:'Hanken Grotesk',sans-serif;font-weight:600;font-size:.95rem;cursor:pointer;transition:background-color .2s ease,color .2s ease,box-shadow .2s ease,transform .15s cubic-bezier(.23,1,.32,1)}.ds-chip:hover{box-shadow:inset 0 0 0 1.5px #17110e}.ds-chip:active{transform:scale(.96)}.ds-chip[aria-pressed=true]{background:#17110e;color:#fff;box-shadow:none}.ds-chip:focus-visible{outline:2px solid #c4145d;outline-offset:3px}"
    },
    {
      "name": "Plus-Knopf",
      "kind": "button",
      "refersTo": "plus",
      "description": "Gericht auf den Bestellzettel legen (Speisekarte).",
      "html": "<button class=\"ds-plus\" aria-label=\"Hinzufügen\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-plus{width:44px;height:44px;border-radius:50%;border:0;display:grid;place-items:center;background:#17110e;color:#fff;cursor:pointer;transition:transform .2s cubic-bezier(.23,1,.32,1),background-color .2s ease}.ds-plus svg{width:20px;height:20px}.ds-plus:hover{background:#c4145d}.ds-plus:active{transform:scale(.9)}.ds-plus:focus-visible{outline:2px solid #c4145d;outline-offset:3px}"
    },
    {
      "name": "Kopf",
      "kind": "nav",
      "refersTo": "kopf",
      "description": "Fester Kopf im Zustand is-fest: Weiß mit Blur, Text-Pillen-Navigation, Status, Bestellen.",
      "html": "<header class=\"ds-kopf\"><span class=\"ds-marke\">Bombay</span><nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Start</a><a href=\"#\">Speisekarte</a><a href=\"#\">Besuch</a></nav><span class=\"ds-status\"><i></i>Heute offen bis 22:00</span><a class=\"ds-kopf-pille\" href=\"#\">Bestellen</a></header>",
